@model Emplyo.Web.Controllers.ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
    ViewData["Heading"] = "Reset your password";
    ViewData["Subheading"] = "We will send reset instructions if the account exists";
}
<form asp-action="ForgotPassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="field mb-3">
        <label asp-for="Email">Email address</label>
        <input asp-for="Email" class="form-control" type="email" autocomplete="username" placeholder="you@company.com" />
        <span asp-validation-for="Email" class="validation"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100 justify-content-center">Send reset instructions</button>
</form>
<p class="text-center mt-3 mb-0"><a asp-action="Login" class="small">Back to sign in</a></p>
