@{
    ViewData["Title"] = "Access denied";
}
<div class="error-page error-page--compact">
    <div>
        <div class="code"><i class="bi bi-shield-lock"></i></div>
        <h1 class="h3 mt-3">Access denied</h1>
        <p class="text-muted">You do not have permission to access this page. If you believe this is an error, contact your administrator.</p>
        <div class="d-flex gap-2 justify-content-center mt-3">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Dashboard</a>
            <button type="button" class="btn btn-secondary" data-history-back><i class="bi bi-arrow-left"></i> Go back</button>
        </div>
    </div>
</div>
