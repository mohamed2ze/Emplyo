@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Check your inbox";
    ViewData["Heading"] = "Check your inbox";
    ViewData["Subheading"] = "If an account exists, reset instructions have been sent";
    var emailEnabled = ViewData["EmailEnabled"] as bool? ?? false;
}
<div class="alert alert-info mb-3">
    For your security, we do not reveal whether an email address is registered.
</div>
@if (!emailEnabled)
{
    <div class="alert alert-warning mb-3">
        Email delivery is not configured on this environment. Ask an administrator to reset your password from
        <strong>User management</strong>, or configure SMTP in application settings.
    </div>
}
<a asp-action="Login" class="btn btn-primary w-100 justify-content-center">Back to sign in</a>
