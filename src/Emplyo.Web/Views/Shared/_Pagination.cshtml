@model PaginationViewModel
@{
    var query = ViewContext.HttpContext.Request.Query;
    var routeValues = new Dictionary<string, string?>();
    foreach (var item in query)
    {
        if (!string.Equals(item.Key, "page", StringComparison.OrdinalIgnoreCase))
            routeValues[item.Key] = item.Value.ToString();
    }
    var start = Model.TotalCount == 0 ? 0 : (Model.CurrentPage - 1) * Model.PageSize + 1;
    var end = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);
    var windowStart = Math.Max(1, Model.CurrentPage - 2);
    var windowEnd = Math.Min(Model.TotalPages, windowStart + 4);
    windowStart = Math.Max(1, windowEnd - 4);
}
<div class="pagination">
    <div class="pagination__info">
        @if (Model.TotalCount == 0)
        {
            <span>No results</span>
        }
        else
        {
            <span>Showing @start–@end of @Model.TotalCount</span>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav class="pagination__controls" aria-label="Pagination">
            @{
                var prevValues = new Dictionary<string, string?>(routeValues) { ["page"] = (Model.CurrentPage - 1).ToString() };
                var nextValues = new Dictionary<string, string?>(routeValues) { ["page"] = (Model.CurrentPage + 1).ToString() };
            }
            <a class="page-link @(Model.HasPrevious ? "" : "disabled")" asp-action="@Model.Action" asp-all-route-data="prevValues" aria-label="Previous"><i class="bi bi-chevron-left"></i></a>
            @for (var p = windowStart; p <= windowEnd; p++)
            {
                var pageValues = new Dictionary<string, string?>(routeValues) { ["page"] = p.ToString() };
                <a class="page-link @(p == Model.CurrentPage ? "active" : "")" asp-action="@Model.Action" asp-all-route-data="pageValues">@p</a>
            }
            <a class="page-link @(Model.HasNext ? "" : "disabled")" asp-action="@Model.Action" asp-all-route-data="nextValues" aria-label="Next"><i class="bi bi-chevron-right"></i></a>
        </nav>
    }
</div>
