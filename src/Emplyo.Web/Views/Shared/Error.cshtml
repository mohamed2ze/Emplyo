@model ErrorViewModel
@{
    ViewData["Title"] = "Unable to load this page";
}
<div class="error-page">
    <div>
        <div class="code">500</div>
        <h1 class="h3 mt-3">Unable to load this page</h1>
        <p class="text-muted">The server could not complete this request. Reload the page to try again. If the problem continues, give your administrator the reference below.</p>
        @if (Model is { ShowRequestId: true, RequestId: not null })
        {
            <p class="text-muted small">Reference: <code>@Model.RequestId</code></p>
        }
        <div class="d-flex gap-2 justify-content-center mt-2"><button type="button" class="btn btn-primary" data-reload><i class="bi bi-arrow-clockwise"></i> Reload page</button><a class="btn btn-secondary" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Back to dashboard</a></div>
    </div>
</div>
