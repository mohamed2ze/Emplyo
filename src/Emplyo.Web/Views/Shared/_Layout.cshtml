@using Emplyo.Application.Common.Interfaces
@using Emplyo.Application.Notifications
@inject INotificationQueryService Notifications
@inject ICurrentUserService CurrentUser
@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var unread = isAuthenticated ? await Notifications.GetUnreadCountAsync(CurrentUser.UserId!) : 0;
    var displayName = CurrentUser.DisplayName;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Emplyo</title>
    <meta name="description" content="Emplyo employee management: employee records, attendance, leave, onboarding and HR reporting." />
    <meta name="theme-color" content="#172B4D" />
    <link rel="icon" type="image/png" href="~/img/emplyo-icon.png" />
    <link rel="preload" href="~/lib/inter/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/inter/inter.css" />
    <link rel="stylesheet" href="~/css/emplyo.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <partial name="_Sidebar" />
        <div class="sidebar-backdrop"></div>
        <div class="main">
            <header class="topbar">
                <button class="nav-toggle" data-nav-toggle aria-label="Toggle navigation"><i class="bi bi-list"></i></button>
                <div class="topbar__title">@(ViewData["Title"] ?? "Dashboard")</div>
                <div class="topbar__spacer"></div>

                <a asp-controller="Notifications" asp-action="Index" class="topbar__icon-btn" aria-label="Notifications">
                    <i class="bi bi-bell"></i>
                    @if (unread > 0)
                    {
                        <span class="dot"></span>
                    }
                </a>

                <div class="dropdown">
                    <button class="btn btn-ghost dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar sm">@Ui.Initials(displayName)</span>
                        <span class="d-none d-md-inline">@displayName</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>My profile</a></li>
                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Change password</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </header>

            <main class="content">
                <partial name="_Toast" />
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script src="~/js/emplyo.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
