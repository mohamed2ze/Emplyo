@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
    var warning = TempData["Warning"] as string;
    var info = TempData["Info"] as string;
}
@if (!string.IsNullOrEmpty(success) || !string.IsNullOrEmpty(error) || !string.IsNullOrEmpty(warning) || !string.IsNullOrEmpty(info))
{
    <div class="toast-stack">
        @if (!string.IsNullOrEmpty(success))
        {
            <div class="toast-item success" role="status"><i class="bi bi-check-circle-fill text-success"></i><span>@success</span><button class="toast-close" aria-label="Dismiss">&times;</button></div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="toast-item error" role="alert"><i class="bi bi-exclamation-octagon-fill text-danger"></i><span>@error</span><button class="toast-close" aria-label="Dismiss">&times;</button></div>
        }
        @if (!string.IsNullOrEmpty(warning))
        {
            <div class="toast-item warning" role="alert"><i class="bi bi-exclamation-triangle-fill text-warning"></i><span>@warning</span><button class="toast-close" aria-label="Dismiss">&times;</button></div>
        }
        @if (!string.IsNullOrEmpty(info))
        {
            <div class="toast-item" role="status"><i class="bi bi-info-circle-fill text-primary"></i><span>@info</span><button class="toast-close" aria-label="Dismiss">&times;</button></div>
        }
    </div>
}
