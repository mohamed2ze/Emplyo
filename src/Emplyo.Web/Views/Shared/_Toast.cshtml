@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
    var warning = TempData["Warning"] as string;
    var info = TempData["Info"] as string;
}
@if (!string.IsNullOrEmpty(success) || !string.IsNullOrEmpty(error) || !string.IsNullOrEmpty(warning) || !string.IsNullOrEmpty(info))
{
    <div class="toast-stack" aria-live="polite">
        @if (!string.IsNullOrEmpty(success))
        {
            <div class="toast-item success" role="status"><i class="bi bi-check-circle-fill text-success" aria-hidden="true"></i><span>@success</span><button type="button" class="toast-close" aria-label="Dismiss"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="toast-item error" role="alert"><i class="bi bi-exclamation-octagon-fill text-danger" aria-hidden="true"></i><span>@error</span><button type="button" class="toast-close" aria-label="Dismiss"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
        }
        @if (!string.IsNullOrEmpty(warning))
        {
            <div class="toast-item warning" role="status"><i class="bi bi-exclamation-triangle-fill text-warning" aria-hidden="true"></i><span>@warning</span><button type="button" class="toast-close" aria-label="Dismiss"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
        }
        @if (!string.IsNullOrEmpty(info))
        {
            <div class="toast-item" role="status"><i class="bi bi-info-circle-fill text-primary" aria-hidden="true"></i><span>@info</span><button type="button" class="toast-close" aria-label="Dismiss"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
        }
    </div>
}
