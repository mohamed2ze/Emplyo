<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Emplyo</title>
    <meta name="description" content="Sign in to Emplyo employee management." />
    <meta name="theme-color" content="#172B4D" />
    <link rel="icon" type="image/png" href="~/img/emplyo-icon.png" />
    <link rel="preload" href="~/lib/inter/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/inter/inter.css" />
    <link rel="stylesheet" href="~/css/emplyo.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-wrap">
        <div class="auth-card">
            <div class="auth-card__head">
                <img src="~/img/emplyo-banner.png" alt="Emplyo — Employee Management System" class="auth-banner" />
                <h1 class="h4 mb-1">@(ViewData["Heading"] ?? "Welcome back")</h1>
                <p class="text-muted mb-0">@(ViewData["Subheading"] ?? "Sign in to your Emplyo account")</p>
            </div>
            <div class="auth-card__body">
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
