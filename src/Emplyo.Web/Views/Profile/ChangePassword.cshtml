@model Emplyo.Web.Controllers.ChangePasswordViewModel
<div class="page-head"><div class="page-head__text"><nav class="breadcrumb"><a asp-action="Index">My profile</a><span>/</span>Change password</nav><h1>Change password</h1></div></div>
<form asp-action="ChangePassword" method="post" style="max-width:520px">
    <div class="card"><div class="card__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="field mb-3"><label asp-for="CurrentPassword">Current password</label><input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" /><span asp-validation-for="CurrentPassword" class="validation"></span></div>
        <div class="field mb-3"><label asp-for="NewPassword">New password</label><input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" /><span class="hint">At least 12 characters with upper, lower, number and symbol.</span><span asp-validation-for="NewPassword" class="validation"></span></div>
        <div class="field mb-3"><label asp-for="ConfirmPassword">Confirm new password</label><input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="validation"></span></div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-shield-lock"></i> Update password</button>
    </div></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
