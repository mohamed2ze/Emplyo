        <div class="card__head" style="border-top:1px solid var(--border);border-bottom:none"><a class="btn btn-secondary" asp-action="Index">Cancel</a><span class="spacer"></span><button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i> Create</button></div>
    </div>
