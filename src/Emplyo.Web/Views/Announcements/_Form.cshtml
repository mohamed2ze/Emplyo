@using Emplyo.Application.Organization
@model AnnouncementFormDto
@{
    var departments = ViewBag.Departments as IReadOnlyList<LookupItemDto> ?? new List<LookupItemDto>();
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="form-grid">
    <div class="field span-2"><label asp-for="Title">Title <span class="req">*</span></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="validation"></span></div>
    <div class="field span-2"><label asp-for="Body">Body <span class="req">*</span></label><textarea asp-for="Body" class="form-control" rows="6" maxlength="4000"></textarea><span asp-validation-for="Body" class="validation"></span></div>
    <div class="field">
        <label asp-for="Audience">Audience</label>
        <select asp-for="Audience" class="form-select" asp-items="Ui.Options<AnnouncementAudience>(Ui.AnnouncementAudienceLabel)"></select>
    </div>
    <div class="field">
        <label asp-for="DepartmentId">Department (for department audience)</label>
        <select asp-for="DepartmentId" class="form-select">
            <option value="">None</option>
            @foreach (var d in departments) { <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option> }
        </select>
    </div>
    <div class="field"><label class="checkbox"><input asp-for="PublishNow" type="checkbox" /> <span>Publish now</span></label></div>
    <div class="field"><label asp-for="PublishAt">Publish at (optional)</label><input asp-for="PublishAt" type="datetime-local" class="form-control" /></div>
    <div class="field"><label asp-for="ExpiresAt">Expires at (optional)</label><input asp-for="ExpiresAt" type="datetime-local" class="form-control" /></div>
</div>
