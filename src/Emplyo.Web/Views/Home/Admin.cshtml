@model AdminDashboardDto
@{
    var chartLabels = Model.HeadcountByDepartment.Select(d => d.DepartmentName).ToList();
    var chartValues = Model.HeadcountByDepartment.Select(d => d.TotalCount).ToList();
    var statusLabels = Model.StatusSummary.Select(s => s.Status.ToString()).ToList();
    var statusValues = Model.StatusSummary.Select(s => s.Count).ToList();
}
<div class="page-head">
    <div class="page-head__text">
        <h1>Administrator dashboard</h1>
        <p>Organization-wide overview of people, time-off and recent activity.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn-secondary" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line"></i> Reports</a>
        <a class="btn btn-primary" asp-controller="Employees" asp-action="Create"><i class="bi bi-person-plus"></i> Add employee</a>
    </div>
</div>

<div class="stat-grid mb-4">
    <div class="stat"><div class="stat__icon"><i class="bi bi-people"></i></div><div><div class="stat__value">@Model.TotalEmployees</div><div class="stat__label">Total employees</div></div></div>
    <div class="stat"><div class="stat__icon green"><i class="bi bi-person-check"></i></div><div><div class="stat__value">@Model.ActiveEmployees</div><div class="stat__label">Active</div></div></div>
    <div class="stat"><div class="stat__icon amber"><i class="bi bi-airplane"></i></div><div><div class="stat__value">@Model.OnLeaveCount</div><div class="stat__label">On leave</div></div></div>
    <div class="stat"><div class="stat__icon teal"><i class="bi bi-diagram-3"></i></div><div><div class="stat__value">@Model.DepartmentCount</div><div class="stat__label">Departments</div></div></div>
    <div class="stat"><div class="stat__icon red"><i class="bi bi-hourglass-split"></i></div><div><div class="stat__value">@Model.PendingLeaveRequests</div><div class="stat__label">Pending leave</div></div></div>
</div>

<div class="grid-2">
    <div class="card">
        <div class="card__head"><h3>Headcount by department</h3></div>
        <div class="card__body">
            @if (Model.HeadcountByDepartment.Any())
            {
                <div class="chart-box"><canvas data-chart="bar" data-chart-labels="@System.Text.Json.JsonSerializer.Serialize(chartLabels)" data-chart-values="@System.Text.Json.JsonSerializer.Serialize(chartValues)"></canvas></div>
            }
            else { <div class="empty"><i class="bi bi-diagram-3"></i><p class="mb-0">No departments have been created yet.</p></div> }
        </div>
    </div>
    <div class="card">
        <div class="card__head"><h3>Employment status</h3></div>
        <div class="card__body">
            @if (Model.TotalEmployees > 0)
            {
                <div class="chart-box"><canvas data-chart="doughnut" data-chart-labels="@System.Text.Json.JsonSerializer.Serialize(statusLabels)" data-chart-values="@System.Text.Json.JsonSerializer.Serialize(statusValues)"></canvas></div>
            }
            else { <div class="empty"><i class="bi bi-people"></i><p class="mb-0">No employee records yet.</p></div> }
        </div>
    </div>
</div>

<div class="grid-2 mt-0">
    <div class="card">
        <div class="card__head"><h3>Recent hires</h3><span class="spacer"></span><a asp-controller="Employees" asp-action="Index" class="small">View all</a></div>
        <div class="card__body p-0">
            @if (Model.RecentHires.Any())
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead><tr><th>Employee</th><th>Department</th><th>Hired</th></tr></thead>
                        <tbody>
                        @foreach (var h in Model.RecentHires)
                        {
                            <tr>
                                <td><a class="row-link" asp-controller="Employees" asp-action="Details" asp-route-id="@h.EmployeeId">@h.EmployeeName</a></td>
                                <td>@(h.DepartmentName ?? "—")</td>
                                <td>@h.HireDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else { <div class="empty"><i class="bi bi-person-plus"></i><p class="mb-0">No hires recorded yet.</p></div> }
        </div>
    </div>
    <div class="card">
        <div class="card__head"><h3>Recent activity</h3><span class="spacer"></span><a asp-controller="Audit" asp-action="Index" class="small">Audit logs</a></div>
        <div class="card__body p-0">
            @if (Model.RecentActivity.Any())
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead><tr><th>Action</th><th>Actor</th><th>When</th></tr></thead>
                        <tbody>
                        @foreach (var a in Model.RecentActivity)
                        {
                            <tr>
                                <td><span class="badge-soft">@a.Action</span></td>
                                <td>@a.ActorName</td>
                                <td class="text-muted">@Tz.ToLocal(a.TimestampUtc).ToString("dd MMM HH:mm")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else { <div class="empty"><i class="bi bi-activity"></i><p class="mb-0">No activity logged yet.</p></div> }
        </div>
    </div>
</div>

<div class="card">
    <div class="card__head"><h3>Upcoming holidays</h3></div>
    <div class="card__body">
        @if (Model.UpcomingHolidays.Any())
        {
            <div class="d-flex flex-wrap gap-3">
                @foreach (var h in Model.UpcomingHolidays)
                {
                    <div class="badge-soft d-flex align-items-center gap-2"><i class="bi bi-calendar-event"></i>@h.Name · @h.Date.ToString("dd MMM yyyy")</div>
                }
            </div>
        }
        else { <p class="text-muted mb-0">No upcoming holidays configured.</p> }
    </div>
</div>
