@model EditUserDto
@{
    var user = ViewBag.User as UserListItemDto;
    var roles = ViewBag.Roles as string[] ?? new[] { "Administrator", "HRManager", "Employee" };
    var employees = ViewBag.Employees as IReadOnlyList<(int Id, string Name, string Number)> ?? new List<(int, string, string)>();
}
<div class="page-head"><div class="page-head__text"><nav class="breadcrumb"><a asp-action="Index">Users</a><span>/</span>Edit</nav><h1>Edit @user?.DisplayName</h1><p>@user?.Email</p></div></div>
<form asp-action="Edit" method="post">
    <div class="card"><div class="card__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="form-grid">
            <div class="field">
                <label asp-for="Role">Role</label>
                <select asp-for="Role" class="form-select">
                    @foreach (var r in roles) { <option value="@r" selected="@(Model.Role == r)">@r</option> }
                </select>
            </div>
            <div class="field">
                <label asp-for="EmployeeId">Linked employee</label>
                <select asp-for="EmployeeId" class="form-select">
                    <option value="">— Not linked —</option>
                    @foreach (var e in employees) { <option value="@e.Id" selected="@(Model.EmployeeId == e.Id)">@e.Name (@e.Number)</option> }
                </select>
            </div>
            <div class="field"><label class="checkbox"><input asp-for="IsActive" type="checkbox" /> <span>Account active</span></label></div>
        </div>
        <div class="alert alert-warning mt-3 mb-0"><i class="bi bi-shield-lock me-1"></i> Deactivating an account locks the user out but preserves all records and audit history.</div>
    </div>
    <div class="card__head" style="border:none">
        <a class="btn btn-secondary" asp-action="Index">Cancel</a><span class="spacer"></span>
        <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i> Save changes</button>
    </div>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
