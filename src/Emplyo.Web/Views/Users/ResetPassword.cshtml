@model ResetUserPasswordDto
@{
    var user = ViewBag.User as UserListItemDto;
}
<div class="page-head"><div class="page-head__text"><nav class="breadcrumb"><a asp-action="Index">User management</a><span>/</span>Reset password</nav><h1>Reset password · @user?.DisplayName</h1><p>@user?.Email</p></div></div>
<form asp-action="ResetPassword" method="post">
    <div class="card"><div class="card__body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="alert alert-info"><i class="bi bi-info-circle me-1"></i> The password reset is recorded in the audit log. The new password is never logged or emailed automatically.</div>
        <div class="field field--md"><label asp-for="NewPassword">New password <span class="req">*</span></label><input asp-for="NewPassword" type="text" class="form-control" autocomplete="off" /><span class="hint">12+ characters with upper, lower, number and symbol.</span><span asp-validation-for="NewPassword" class="validation"></span></div>
    </div>
    <div class="card__foot">
        <a class="btn btn-secondary" asp-action="Index">Cancel</a><span class="spacer"></span>
        <button class="btn btn-primary" type="submit" data-confirm="Reset this user's password?"><i class="bi bi-key"></i> Reset password</button>
    </div>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
