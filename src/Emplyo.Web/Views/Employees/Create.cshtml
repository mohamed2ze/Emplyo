@model EmployeeFormViewModel
@{
    ViewData["Title"] = "Add employee";
}
<div class="page-head">
    <div class="page-head__text">
        <nav class="breadcrumb"><a asp-action="Index">Employees</a><span>/</span>Add employee</nav>
        <h1>Add employee</h1>
        <p>Create a new employee record. Fields marked with * are required.</p>
    </div>
</div>

<form asp-action="Create" method="post">
    <div class="card">
        <div class="card__body">
            <partial name="_EmployeeForm" model="Model" />
        </div>
        <div class="card__foot">
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            <span class="spacer"></span>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Create employee</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
