@model EmployeeFormViewModel
@{
    ViewData["Title"] = $"Edit {Model.EmployeeName}";
}
<div class="page-head">
    <div class="page-head__text">
        <nav class="breadcrumb"><a asp-action="Index">Employees</a><span>/</span><a asp-action="Details" asp-route-id="@Model.Id">@Model.EmployeeName</a><span>/</span>Edit</nav>
        <h1>Edit employee</h1>
        <p>Update @Model.EmployeeName's record.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-arrow-left"></i> Back to profile</a>
    </div>
</div>

<div class="card">
    <div class="card__body">
        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="avatar lg">
                @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
                {
                    <img src="@Url.Action("Photo", new { id = Model.Id })" alt="" />
                }
                else
                {
                    @Ui.Initials(Model.EmployeeName)
                }
            </span>
            <div>
                <h3 class="h6 mb-1">Profile photo</h3>
                <form asp-action="UploadPhoto" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="d-flex gap-2 align-items-center">
                    <input type="file" name="photo" accept=".jpg,.jpeg,.png,.webp" class="form-control form-control-sm photo-input" />
                    <button type="submit" class="btn btn-secondary btn-sm">Upload</button>
                </form>
                <span class="hint">JPG, PNG or WEBP · max 4 MB.</span>
            </div>
        </div>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <partial name="_EmployeeForm" model="Model" />
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save changes</button>
                <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
