@model EmployeeFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<h3 class="h6 text-muted mb-3 mt-1">Basic information</h3>
<div class="form-grid">
    <div class="field">
        <label asp-for="Form.EmployeeNumber">Employee number <span class="req">*</span></label>
        <input asp-for="Form.EmployeeNumber" class="form-control" placeholder="EMP-0001" />
        <span asp-validation-for="Form.EmployeeNumber" class="validation"></span>
    </div>
    <div class="field">
        <label asp-for="Form.WorkEmail">Work email <span class="req">*</span></label>
        <input asp-for="Form.WorkEmail" type="email" class="form-control" placeholder="name@company.com" />
        <span asp-validation-for="Form.WorkEmail" class="validation"></span>
    </div>
    <div class="field">
        <label asp-for="Form.FirstName">First name <span class="req">*</span></label>
        <input asp-for="Form.FirstName" class="form-control" />
        <span asp-validation-for="Form.FirstName" class="validation"></span>
    </div>
    <div class="field">
        <label asp-for="Form.LastName">Last name <span class="req">*</span></label>
        <input asp-for="Form.LastName" class="form-control" />
        <span asp-validation-for="Form.LastName" class="validation"></span>
    </div>
    <div class="field">
        <label asp-for="Form.PhoneNumber">Phone number</label>
        <input asp-for="Form.PhoneNumber" class="form-control" />
    </div>
    <div class="field">
        <label asp-for="Form.WorkLocation">Work location</label>
        <input asp-for="Form.WorkLocation" class="form-control" placeholder="Head Office" />
    </div>
</div>

<h3 class="h6 text-muted mb-3 mt-4">Employment</h3>
<div class="form-grid">
    <div class="field">
        <label asp-for="Form.DepartmentId">Department</label>
        <select asp-for="Form.DepartmentId" class="form-select">
            <option value="">Unassigned</option>
            @foreach (var d in Model.Departments)
            {
                <option value="@d.Id" selected="@(Model.Form.DepartmentId == d.Id)">@d.Name</option>
            }
        </select>
    </div>
    <div class="field">
        <label asp-for="Form.PositionId">Position</label>
        <select asp-for="Form.PositionId" class="form-select">
            <option value="">Unassigned</option>
            @foreach (var p in Model.Positions)
            {
                <option value="@p.Id" selected="@(Model.Form.PositionId == p.Id)">@p.Name</option>
            }
        </select>
    </div>
    <div class="field">
        <label asp-for="Form.ManagerId">Manager</label>
        <select asp-for="Form.ManagerId" class="form-select">
            <option value="">None</option>
            @foreach (var m in Model.Managers)
            {
                <option value="@m.Id" selected="@(Model.Form.ManagerId == m.Id)">@m.FullName (@m.EmployeeNumber)</option>
            }
        </select>
    </div>
    <div class="field">
        <label asp-for="Form.HireDate">Hire date <span class="req">*</span></label>
        <input asp-for="Form.HireDate" type="date" class="form-control" />
        <span asp-validation-for="Form.HireDate" class="validation"></span>
    </div>
    <div class="field">
        <label asp-for="Form.EmploymentType">Employment type</label>
        <select asp-for="Form.EmploymentType" class="form-select" asp-items="Ui.Options<EmploymentType>(Ui.EmploymentTypeLabel)"></select>
    </div>
    @if (!Model.IsEdit)
    {
        <div class="field">
            <label asp-for="Form.EmploymentStatus">Initial status</label>
            <select asp-for="Form.EmploymentStatus" class="form-select" asp-items="Ui.Options<EmploymentStatus>()"></select>
        </div>
    }
    <div class="field">
        <label asp-for="Form.AnnualCompensation">Annual compensation</label>
        <input asp-for="Form.AnnualCompensation" type="number" step="0.01" min="0" class="form-control" />
        <span class="hint">Visible to administrators and HR only.</span>
    </div>
    <div class="field">
        <label asp-for="Form.CompensationCurrency">Currency</label>
        <input asp-for="Form.CompensationCurrency" class="form-control" maxlength="3" placeholder="USD" />
    </div>
</div>

<h3 class="h6 text-muted mb-3 mt-4">Address &amp; emergency contact</h3>
<div class="form-grid">
    <div class="field span-2">
        <label asp-for="Form.AddressLine">Address</label>
        <input asp-for="Form.AddressLine" class="form-control" />
    </div>
    <div class="field">
        <label asp-for="Form.City">City</label>
        <input asp-for="Form.City" class="form-control" />
    </div>
    <div class="field">
        <label asp-for="Form.Country">Country</label>
        <input asp-for="Form.Country" class="form-control" />
    </div>
    <div class="field">
        <label asp-for="Form.EmergencyContactName">Emergency contact name</label>
        <input asp-for="Form.EmergencyContactName" class="form-control" />
    </div>
    <div class="field">
        <label asp-for="Form.EmergencyContactPhone">Emergency contact phone</label>
        <input asp-for="Form.EmergencyContactPhone" class="form-control" />
    </div>
</div>
