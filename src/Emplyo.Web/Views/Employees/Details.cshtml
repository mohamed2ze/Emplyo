@model EmployeeDetailsViewModel
@{
    var e = Model.Employee;
    ViewData["Title"] = e.FullName;
}
<div class="page-head">
    <div class="page-head__text">
        <nav class="breadcrumb"><a asp-action="Index">Employees</a><span>/</span>@e.FullName</nav>
        <h1>@e.FullName</h1>
        <p>@(e.PositionTitle ?? "No position") · @(e.DepartmentName ?? "Unassigned") · @Html.Raw(Ui.EmploymentStatusBadge(e.EmploymentStatus))</p>
    </div>
    <div class="page-head__actions">
        @if (Model.CanEdit)
        {
            <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@e.Id"><i class="bi bi-pencil"></i> Edit</a>
        }
    </div>
</div>

<div class="grid-3" style="grid-template-columns: 320px 1fr">
    <div>
        <div class="card">
            <div class="card__body text-center">
                <span class="avatar lg mx-auto mb-3" style="margin:0 auto">
                    @if (!string.IsNullOrEmpty(e.ProfilePhotoPath))
                    {
                        <img src="@Url.Action("Photo", new { id = e.Id })" alt="" />
                    }
                    else
                    {
                        @Ui.Initials(e.FullName)
                    }
                </span>
                <h3 class="h5 mb-1">@e.FullName</h3>
                <p class="text-muted mb-2">@e.EmployeeNumber</p>
                @Html.Raw(Ui.EmploymentStatusBadge(e.EmploymentStatus))
                <hr />
                <div class="text-start">
                    <div class="mb-2"><i class="bi bi-envelope me-2 text-muted"></i>@e.WorkEmail</div>
                    <div class="mb-2"><i class="bi bi-telephone me-2 text-muted"></i>@(e.PhoneNumber ?? "—")</div>
                    <div class="mb-2"><i class="bi bi-geo-alt me-2 text-muted"></i>@(e.WorkLocation ?? "—")</div>
                    <div class="mb-2"><i class="bi bi-person-badge me-2 text-muted"></i>Manager: @(e.ManagerName ?? "—")</div>
                    <div class="mb-2"><i class="bi bi-calendar-check me-2 text-muted"></i>Hired @e.HireDate.ToString("dd MMM yyyy")</div>
                    @if (e.TerminationDate.HasValue)
                    {
                        <div class="mb-2 text-danger"><i class="bi bi-box-arrow-right me-2"></i>Terminated @e.TerminationDate.Value.ToString("dd MMM yyyy")</div>
                    }
                </div>
            </div>
        </div>

        @if (Model.CanEdit)
        {
            <div class="card">
                <div class="card__head"><h3>Employment status</h3></div>
                <div class="card__body">
                    <form asp-action="ChangeStatus" asp-route-id="@e.Id" method="post" class="d-flex gap-2">
                        <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<EmploymentStatus>()">
                            <option value="@e.EmploymentStatus" selected>@Ui.Humanize(e.EmploymentStatus) (current)</option>
                        </select>
                        <button type="submit" class="btn btn-primary" data-confirm="Change the employment status for @e.FullName?">Update</button>
                    </form>
                    <p class="hint mt-2 mb-0">Status changes are recorded in the audit log. Terminated employees are preserved for historical records.</p>
                </div>
            </div>
        }
    </div>

    <div>
        <div class="card">
            <div class="card__head"><h3>Employment information</h3></div>
            <div class="card__body">
                <dl class="dl">
                    <dt>Employee number</dt><dd>@e.EmployeeNumber</dd>
                    <dt>Department</dt><dd>@(e.DepartmentName ?? "—")</dd>
                    <dt>Position</dt><dd>@(e.PositionTitle ?? "—")</dd>
                    <dt>Manager</dt><dd>@(e.ManagerName ?? "—")</dd>
                    <dt>Employment type</dt><dd>@Ui.EmploymentTypeLabel(e.EmploymentType)</dd>
                    <dt>Hire date</dt><dd>@e.HireDate.ToString("dd MMM yyyy")</dd>
                    <dt>Work location</dt><dd>@(e.WorkLocation ?? "—")</dd>
                    <dt>Address</dt><dd>@(string.IsNullOrWhiteSpace(e.AddressLine) ? "—" : $"{e.AddressLine}, {e.City}, {e.Country}".Trim(',', ' '))</dd>
                    <dt>Emergency contact</dt><dd>@(e.EmergencyContactName ?? "—") @(e.EmergencyContactPhone is not null ? $"· {e.EmergencyContactPhone}" : "")</dd>
                    @if (Model.CanViewSensitive)
                    {
                        <dt>Annual compensation</dt>
                        <dd>@(e.AnnualCompensation.HasValue ? $"{e.AnnualCompensation.Value.ToString("N2")} {e.CompensationCurrency}" : "—") <span class="badge-soft ms-1"><i class="bi bi-lock"></i> Restricted</span></dd>
                    }
                    <dt>User account</dt><dd>@(e.UserId is not null ? "Linked" : "Not linked")</dd>
                    <dt>Created</dt><dd>@Tz.ToLocal(e.CreatedAtUtc).ToString("dd MMM yyyy HH:mm")</dd>
                    <dt>Last updated</dt><dd>@Tz.ToLocal(e.UpdatedAtUtc).ToString("dd MMM yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>

        <div class="card">
            <div class="card__head"><h3>Recent attendance</h3></div>
            <div class="card__body p-0">
                @if (Model.RecentAttendance.Any())
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead><tr><th>Date</th><th>In</th><th>Out</th><th>Status</th></tr></thead>
                            <tbody>
                            @foreach (var a in Model.RecentAttendance.Take(8))
                            {
                                <tr>
                                    <td>@a.WorkDate.ToString("dd MMM yyyy")</td>
                                    <td>@(a.ClockInUtc.HasValue ? Tz.ToLocal(a.ClockInUtc.Value).ToString("HH:mm") : "—")</td>
                                    <td>@(a.ClockOutUtc.HasValue ? Tz.ToLocal(a.ClockOutUtc.Value).ToString("HH:mm") : "—")</td>
                                    <td>@Html.Raw(Ui.AttendanceStatusBadge(a.Status))</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else { <div class="empty"><i class="bi bi-clock-history"></i><p class="mb-0">No attendance records in the last 30 days.</p></div> }
            </div>
        </div>

        <div class="card">
            <div class="card__head"><h3>Recent leave</h3></div>
            <div class="card__body p-0">
                @if (Model.RecentLeave.Any())
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead><tr><th>Type</th><th>Dates</th><th class="num">Days</th><th>Status</th></tr></thead>
                            <tbody>
                            @foreach (var l in Model.RecentLeave)
                            {
                                <tr>
                                    <td><a class="row-link" asp-controller="Leave" asp-action="Details" asp-route-id="@l.Id">@l.LeaveTypeName</a></td>
                                    <td>@l.StartDate.ToString("dd MMM") – @l.EndDate.ToString("dd MMM yyyy")</td>
                                    <td class="num">@l.TotalDays.ToString("0.#")</td>
                                    <td>@Html.Raw(Ui.LeaveStatusBadge(l.Status))</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else { <div class="empty"><i class="bi bi-calendar2-check"></i><p class="mb-0">No leave requests recorded.</p></div> }
            </div>
        </div>

        <div class="card">
            <div class="card__head">
                <h3>Documents</h3><span class="spacer"></span>
                @if (Model.CanEdit)
                {
                    <a class="btn btn-secondary btn-sm" asp-controller="Documents" asp-action="Upload" asp-route-employeeId="@e.Id"><i class="bi bi-upload"></i> Upload</a>
                }
            </div>
            <div class="card__body p-0">
                @if (Model.Documents.Any())
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead><tr><th>Title</th><th>Category</th><th>Size</th><th>Uploaded</th><th class="text-end">Actions</th></tr></thead>
                            <tbody>
                            @foreach (var d in Model.Documents)
                            {
                                <tr>
                                    <td>
                                        <i class="bi bi-file-earmark me-1"></i>@d.Title
                                        @if (d.IsConfidential) { <span class="badge-soft ms-1"><i class="bi bi-lock"></i> Confidential</span> }
                                    </td>
                                    <td>@Ui.Humanize(d.Category)</td>
                                    <td>@Ui.FileSize(d.SizeBytes)</td>
                                    <td>@d.UploadedAtUtc.ToString("dd MMM yyyy")</td>
                                    <td class="text-end">
                                        <a class="btn btn-secondary btn-sm" asp-controller="Documents" asp-action="Download" asp-route-id="@d.Id"><i class="bi bi-download"></i></a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else { <div class="empty"><i class="bi bi-folder2-open"></i><p class="mb-0">No documents uploaded.</p></div> }
            </div>
        </div>
    </div>
</div>
