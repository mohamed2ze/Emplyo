@using Emplyo.Application.Reporting
@using Emplyo.Application.Organization
@model IReadOnlyList<AttendanceReportRowDto>
@{
    var from = ViewBag.From as DateOnly? ?? DateOnly.FromDateTime(DateTime.UtcNow.AddDays(-30));
    var to = ViewBag.To as DateOnly? ?? DateOnly.FromDateTime(DateTime.UtcNow);
    var departmentId = ViewBag.DepartmentId as int?;
    var departments = ViewBag.Departments as IReadOnlyList<LookupItemDto> ?? new List<LookupItemDto>();
}
<div class="page-head">
    <div class="page-head__text">
        <nav class="breadcrumb"><a asp-action="Index">Reports</a><span>/</span>Attendance</nav>
        <h1>Attendance report</h1>
        <p>@from.ToString("dd MMM yyyy") – @to.ToString("dd MMM yyyy")</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn-secondary" asp-action="ExportAttendance" asp-route-from="@from.ToString("yyyy-MM-dd")" asp-route-to="@to.ToString("yyyy-MM-dd")" asp-route-departmentId="@departmentId"><i class="bi bi-filetype-csv"></i> Export CSV</a>
    </div>
</div>
<div class="card"><div class="card__body">
    <form method="get" asp-action="Attendance" class="toolbar">
        <div class="field"><label for="from">From</label><input id="from" name="from" type="date" value="@from.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="field"><label for="to">To</label><input id="to" name="to" type="date" value="@to.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="field grow">
            <label for="departmentId">Department</label>
            <select id="departmentId" name="departmentId" class="form-select">
                <option value="">All departments</option>
                @foreach (var d in departments) { <option value="@d.Id" selected="@(departmentId == d.Id)">@d.Name</option> }
            </select>
        </div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-funnel"></i> Apply</button>
    </form>
</div></div>
<div class="card"><div class="card__body p-0">
    @if (Model.Any())
    {
        <div class="table-wrap"><table class="data-table">
            <thead><tr><th>Employee</th><th>Department</th><th class="num">Present</th><th class="num">Late</th><th class="num">Absent</th><th class="num">Remote</th><th class="num">Hours</th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.EmployeeName<div class="person__meta">@r.EmployeeNumber</div></td>
                    <td>@(r.DepartmentName ?? "—")</td>
                    <td class="num">@r.PresentDays</td>
                    <td class="num">@r.LateDays</td>
                    <td class="num">@r.AbsentDays</td>
                    <td class="num">@r.RemoteDays</td>
                    <td class="num fw-semibold">@r.TotalHours.ToString("0.##")</td>
                </tr>
            }
            </tbody>
        </table></div>
    }
    else { <div class="empty"><i class="bi bi-clock-history"></i><h4>No attendance data</h4><p>No records in the selected period.</p></div> }
</div></div>
