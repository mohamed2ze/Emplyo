@model LeaveRequestFormDto
@{
    var leaveTypes = ViewBag.LeaveTypes as IReadOnlyList<Emplyo.Domain.Entities.LeaveType> ?? new List<Emplyo.Domain.Entities.LeaveType>();
    var balances = ViewBag.Balances as IReadOnlyList<LeaveBalanceDto> ?? new List<LeaveBalanceDto>();
}
<div class="page-head">
    <div class="page-head__text"><nav class="breadcrumb"><a asp-action="My">My leave</a><span>/</span>New request</nav><h1>Request leave</h1><p>Weekends and company holidays are excluded from the day count.</p></div>
</div>

<div class="grid-3" style="grid-template-columns: 1fr 300px">
    <form asp-action="Create" method="post">
        <div class="card">
            <div class="card__body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="form-grid">
                    <div class="field span-2">
                        <label asp-for="LeaveTypeId">Leave type <span class="req">*</span></label>
                        <select asp-for="LeaveTypeId" class="form-select" required>
                            <option value="">— Select —</option>
                            @foreach (var t in leaveTypes)
                            {
                                <option value="@t.Id" selected="@(Model.LeaveTypeId == t.Id)">@t.Name @(t.IsPaid ? "" : "(unpaid)")</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label asp-for="StartDate">Start date <span class="req">*</span></label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                    </div>
                    <div class="field">
                        <label asp-for="EndDate">End date <span class="req">*</span></label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                    </div>
                    <div class="field">
                        <label class="checkbox"><input asp-for="IsHalfDay" type="checkbox" /> <span>Half day (single date only)</span></label>
                    </div>
                    <div class="field span-2">
                        <label asp-for="Reason">Reason / notes</label>
                        <textarea asp-for="Reason" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-primary" type="submit"><i class="bi bi-send"></i> Submit request</button>
                    <a class="btn btn-secondary" asp-action="My">Cancel</a>
                </div>
            </div>
        </div>
    </form>

    <div class="card">
        <div class="card__head"><h3>Your balances</h3></div>
        <div class="card__body p-0">
            @if (balances.Any())
            {
                <table class="data-table">
                    <tbody>
                    @foreach (var b in balances)
                    {
                        <tr><td>@b.LeaveTypeName</td><td class="num"><strong>@b.Remaining.ToString("0.#")</strong> <span class="text-muted small">/ @b.Entitlement.ToString("0.#")</span></td></tr>
                    }
                    </tbody>
                </table>
            }
            else { <div class="empty"><p class="mb-0">No balances available.</p></div> }
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
