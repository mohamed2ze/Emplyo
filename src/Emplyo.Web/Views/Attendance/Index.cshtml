@model PagedResult<AttendanceListItemDto>
@{
    var filter = ViewBag.Filter as AttendanceFilter ?? new AttendanceFilter();
}
<div class="page-head">
    <div class="page-head__text"><h1>Attendance</h1><p>@Model.TotalCount attendance record(s).</p></div>
    <div class="page-head__actions"><a class="btn btn-primary" asp-action="Correct"><i class="bi bi-pencil-square"></i> Add / correct</a></div>
</div>

<div class="card">
    <div class="card__body">
        <form method="get" asp-action="Index" class="toolbar">
            <div class="field grow"><label for="Search">Employee</label><input id="Search" name="Search" value="@filter.Search" class="form-control" placeholder="Name or number" /></div>
            <div class="field"><label for="From">From</label><input id="From" name="From" type="date" value="@(filter.From?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
            <div class="field"><label for="To">To</label><input id="To" name="To" type="date" value="@(filter.To?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
            <div class="field">
                <label for="Status">Status</label>
                <select id="Status" name="Status" class="form-select" data-auto-submit>
                    <option value="">All</option>
                    @foreach (var s in Enum.GetValues<AttendanceStatus>())
                    {
                        <option value="@s" selected="@(filter.Status == s)">@Ui.Humanize(s)</option>
                    }
                </select>
            </div>
            <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Filter</button>
            <a class="btn btn-ghost" asp-action="Index">Clear</a>
        </form>
    </div>
</div>

<div class="card">
    <div class="card__body p-0">
        @if (Model.Items.Any())
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead><tr><th>Employee</th><th>Date</th><th>Clock-in</th><th>Clock-out</th><th class="num">Hours</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var a in Model.Items)
                    {
                        <tr>
                            <td>
                                <a class="row-link" asp-controller="Employees" asp-action="Details" asp-route-id="@a.EmployeeId">@a.EmployeeName</a>
                                <div class="person__meta">@a.EmployeeNumber · @(a.DepartmentName ?? "—")</div>
                            </td>
                            <td>@a.WorkDate.ToString("dd MMM yyyy")</td>
                            <td>@(a.ClockInUtc.HasValue ? Tz.ToLocal(a.ClockInUtc.Value).ToString("HH:mm") : "—")</td>
                            <td>@(a.ClockOutUtc.HasValue ? Tz.ToLocal(a.ClockOutUtc.Value).ToString("HH:mm") : "—")</td>
                            <td class="num">@(a.WorkedHours?.ToString("0.##") ?? "—")</td>
                            <td>@Html.Raw(Ui.AttendanceStatusBadge(a.Status))</td>
                            <td><div class="table-actions"><a class="btn btn-secondary btn-sm" asp-action="Correct" asp-route-id="@a.Id" aria-label="Correct"><i class="bi bi-pencil"></i></a></div></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="PaginationViewModel.From(Model)" />
        }
        else { <div class="empty"><i class="bi bi-clock-history"></i><h4>No attendance records found</h4><p>Adjust your filters or add a record manually.</p></div> }
    </div>
</div>
